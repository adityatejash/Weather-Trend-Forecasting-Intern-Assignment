# .env.example — Copy this file to .env and set your values
# DO NOT commit .env to Git

# Flask secret key — set a strong random value in production
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-strong-secret-key-here

# Flask server config (defaults shown — change only if needed)
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Set to '1' to enable Flask debug mode (development only — never in production)
FLASK_DEBUG=0
