# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/

# ── Virtual environments ──────────────────────────────────────────────────────
venv/
.venv/
env/
ENV/
.env/

# ── Environment / Secrets ─────────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.secret

# ── Data files (large — download separately from Kaggle) ──────────────────────
data/*.csv
data/*.parquet
data/*.json
data/*.xlsx
data/*.zip
!data/.gitkeep

# ── Trained model files (large — generated by running the pipeline) ───────────
outputs/models/*.pkl
outputs/models/*.json
outputs/models/*.keras
outputs/models/*.h5
outputs/models/*.hdf5
outputs/models/*.joblib

# ── Generated plots (regenerated by pipeline) ─────────────────────────────────
outputs/plots/*.png
outputs/plots/*.jpg
outputs/plots/*.html
static/plots/*.png
static/plots/*.jpg
static/plots/*.html

# ── Generated reports / processed data ───────────────────────────────────────
outputs/reports/*.parquet
outputs/reports/*.html
outputs/reports/*.pdf
# Keep model_results.json — useful benchmark data for recruiters
!outputs/reports/model_results.json

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Temp files ────────────────────────────────────────────────────────────────
temp/
tmp/
*.tmp

# ── IDE / Editor ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.sublime-workspace

# ── OS generated ─────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── TensorFlow / Keras ────────────────────────────────────────────────────────
*.h5
*.hdf5
saved_model/

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Testing ───────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── Flask ─────────────────────────────────────────────────────────────────────
instance/
flask_session/
